# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:8102/ekai
DB_PORT=8102

# Auth
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-at-least-32-chars

# OpenRouter (Kai Agent)
OPENROUTER_API_KEY=

# Runs
RUNS_DIR=./runs

# Ports
HUB_PORT=8100
BACKBONE_PORT=8101

# Vite (prefixo VITE_ para expor ao frontend)
VITE_API_URL=http://localhost:8101
