# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:9032/ekai
DB_PORT=9032

# Auth
JWT_SECRET=change-me-jwt-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret-at-least-32-chars

# OpenRouter (Kai Agent)
OPENROUTER_API_KEY=

# Runs
RUNS_DIR=./runs

# Ports
HUB_PORT=9000
BACKBONE_PORT=9090

# Vite (prefixo VITE_ para expor ao frontend)
VITE_API_URL=http://localhost:9090
